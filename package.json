{
  "name": "suite-territoriale-home",
  "description": "La Suite territoriale - Accueil",
  "version": "0.1.0",
  "private": true,
  "author": "ANCT",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "predev": "rm -rf .next && npm run only-include-used-icons && tsx scripts/warm-api.ts &",
    "prebuild": "rm -rf .next && tsx scripts/prebuild.ts && npm run only-include-used-icons",
    "only-include-used-icons": "node node_modules/@codegouvfr/react-dsfr/bin/only-include-used-icons.js",
    "dev": "next dev",
    "build": "next build",
    "start": "next start --port 3000",
    "prepare": "husky",
    "lint": "prettier --write '**/*.{ts,tsx,css,md,mdx,mjs,js}' --print-width 100 && eslint src scripts && npm run lint:types",
    "lint:check": "prettier '**/*.{ts,tsx,css,md,mdx,mjs,js}' --list-different --print-width 100 && eslint src scripts && npm run lint:types",
    "lint:types": "tsc --noEmit",
    "seo-check": "node scripts/seo-check.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "test:links": "start-server-and-test 'npm run dev' 8950 'linkinator 'http://localhost:8950' --recurse --skip \"^(?!http://localhost:8950)\"'",
    "test:e2e:install": "playwright install",
    "test:e2e": "playwright test",
    "test:playwright": "NEXT_PUBLIC_BASE_PATH='' NODE_ENV=production npm run build && playwright test",
    "db:drop": "tsx scripts/db-drop.ts",
    "db:browse": "drizzle-kit studio --host=0.0.0.0 --port=8954",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed:sample": "tsx scripts/db-seed.ts ./data/dumps-sample",
    "db:seed": "tsx scripts/db-seed.ts ./data/dumps",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts"
  },
  "prettier": {
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 14",
    "not dead"
  ],
  "dependencies": {
    "@codegouvfr/react-dsfr": "1.26.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "@sentry/nextjs": "^10.68.0",
    "@socialgouv/matomo-next": "^1.9.2",
    "@turf/bbox": "^7.3.5",
    "@turf/turf": "^7.2.0",
    "carte-facile": "^0.8.1",
    "csv-stringify": "^6.6.0",
    "d3": "^7.9.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "husky": "^9.1.7",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.6.2",
    "next": "16.2.11",
    "next-seo": "^6.8.0",
    "pg": "^8.16.3",
    "prop-types": "^15.8.1",
    "rate-limiter-flexible": "^7.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-map-gl": "^8.0.4",
    "rehype-parse": "^9.0.1",
    "rehype-react": "^8.0.0",
    "sharp": "^0.35.3",
    "tss-react": "^4.9.19",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "24.2.0",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "cheerio": "^1.1.2",
    "eslint": "9.32.0",
    "eslint-config-next": "16.2.11",
    "glob": "^13.0.6",
    "jsdom": "^26.1.0",
    "linkinator": "^7.5.0",
    "next-router-mock": "^1.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.2.0",
    "start-server-and-test": "2.1.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "0.35.3",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-linuxmusl-x64": "0.35.3",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2"
  }
}
